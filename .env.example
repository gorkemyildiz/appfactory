# Optional: copy public values to apps/web/.env.local.
# Panel projects currently use localStorage; no Supabase credentials required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never expose using NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Set the same port in web and worker environments if overriding it.
WORKER_PORT=4001

# AI Planner: server-only. Set in the worker environment, never NEXT_PUBLIC.
# e.g. apps/worker/.env then start with Node --env-file (see README).
OPENAI_API_KEY=

# Expo EAS: server-only access token. Never use NEXT_PUBLIC or EXPO_PUBLIC.
EXPO_TOKEN=

# Optional absolute path to eas-cli/bin/run. Defaults to eas on PATH.
EAS_CLI_PATH=
